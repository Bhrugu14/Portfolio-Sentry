# Required — see README.md "Environment variables" for where to get these.
NEXT_PUBLIC_SANITY_PROJECT_ID=m678av4z
NEXT_PUBLIC_SANITY_DATASET=production

# Optional — each feature below is enabled only when its var is set; the app
# runs fine with all of these left blank.
#
# Analytics (self-hosted Umami) — set BOTH or leave BOTH blank; setting only
# one does nothing (see README.md "Analytics" for how to get these).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Your deployed site's URL — used for sitemap.xml, robots.txt, and social
# share image links. Leave blank locally; set it once you have a real
# domain (e.g. https://yourname.com or https://your-project.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Server-only secrets — never import these into client components
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
RESEND_API_KEY=
CONTACT_EMAIL_TO=
