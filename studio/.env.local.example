# Sanity Studio reads env vars prefixed with SANITY_STUDIO_ — see
# sanity.config.ts and sanity.cli.ts. Copy this file to .env.local and fill
# in your own project's values (same numbers as ../web/.env.local.example —
# a Sanity project has exactly one project ID/dataset shared by both apps).
SANITY_STUDIO_PROJECT_ID=m678av4z
SANITY_STUDIO_DATASET=production
